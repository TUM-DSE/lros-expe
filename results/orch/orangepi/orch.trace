# Orchestration trace; see scripts/orch_traces.py for the scenario.
# seed 1; chat every 10000 ms think, idle 40000 ms after turn 4; summarise every 55000 ms x6; reply bursts of 8 at [60000, 150000, 250000] ms
@app chat model=2 prio=0 role=foreground tpot_ms=208 ttft_ms=1000 ttft_tok_ms=60
@app summarise model=0 prio=2 role=background deadline_ms=90000
@app reply model=1 prio=1 role=background deadline_ms=60000
# <t_ms> <app>[:<session>] <max_tokens> <prompt>
